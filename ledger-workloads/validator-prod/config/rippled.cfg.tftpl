# xrpld 3.2.1 — XRPL MAINNET VALIDATOR.
#
# IMPORTANT: [validator_token] is NOT present in this file.
# The signing token is injected at every boot by the ledger-node module
# (token_secret_name -> Secret Manager) — see Task 6 / Phase 2 key ceremony.
# This config is valid and loads cleanly without a signing key; the node
# runs as a non-signing tracking node until the token is present.
#
# IMPORTANT: Every comment MUST be on its OWN line. xrpld does NOT strip
# trailing inline "# ..." from value lines — a trailing comment after any
# value causes beast::BadLexicalCast and crashes the daemon on load.
# (Empirically confirmed in this repo, 2026-06-15.)
#
# No $${...} template interpolations are used — this file is rendered with
# an empty var map {}.

[server]
port_rpc_admin_local
port_peer

# Admin RPC — localhost only; the sidecar agent polls here.
[port_rpc_admin_local]
port = 5005
ip = 127.0.0.1
admin = 127.0.0.1
protocol = http

# P2P peer port. Binding here does NOT by itself mean inbound peers are accepted:
# whether a session forms is decided by wantIncoming, which comes from the
# [peer_private] value below, NOT from this bind and NOT from the forced privacy
# flag. Under peer_private=1 the socket binds and strangers still get no peer
# session. Under peer_private=0, the value set in this file, inbound sessions do
# form. The forced
# privacy flag only suppresses address ADVERTISEMENT and /crawl listing; it has
# never been what blocks inbound. The GCP VPC firewall limits actual ingress.
[port_peer]
port = 51235
ip = 0.0.0.0
protocol = peer

# c3-highmem-8 = 8 vCPU / 64 GB RAM. xrpld size matrix: huge >= 32 GB RAM.
[node_size]
huge

# NuDB is the recommended on-disk ledger store for validators.
# online_delete keeps a rolling 2 000-ledger window (validator does not
# need deep history — Clio feeders carry that burden).
[node_db]
type=NuDB
path=/var/lib/rippled/db/nudb
online_delete=2000
advisory_delete=0

[database_path]
/var/lib/rippled/db

# Rolling history window aligned with online_delete above.
[ledger_history]
2000

# SOFT private. Read the exposure note below before changing this value.
#
# rippled FORCES the privacy flag for any node holding a validation key — upstream
# calls this the "soft" version in its own comment — but the force runs AFTER
# wantIncoming and autoConnect are derived from the ORIGINAL cfg value. Verified on
# the DEPLOYED tag, XRPLF/rippled 3.2.1
# src/xrpld/peerfinder/detail/PeerfinderConfig.cpp (the file is
# src/libxrpl/peerfinder/Config.cpp on develop):
#
#   config.peerPrivate  = peerPrivate;                          // from cfg
#   config.wantIncoming = (!config.peerPrivate) && (port != 0); // ORIGINAL value
#   if (validationPublicKey) config.peerPrivate = true;         // forced AFTER
#   config.autoConnect  = !standalone && !peerPrivate;          // ORIGINAL param
#
#                         | /crawl hidden | Discovery | Inbound | Endpoint gossip
#   validator + 0 (here)  | yes (forced)  | yes       | yes     | YES — see below
#   validator + 1 (prior) | yes           | no        | no      | no
#
# Why changed (Pete, 2026-08-04): 1 left [ips_fixed] as the ENTIRE peer set with no
# discovery fallback and zero inbound peers across 63.8h of uptime — a contributing
# condition in the 2026-07-31 isolation outage (the co-root was process debt: PR #23
# was merged but never applied, so staged hubs were never loaded) and the reason the
# ">=8 peers" target has stayed open. Public-hub pinning is exhausted.
#
# ACCEPTED TRADE-OFF — WIDER THAN "peers we dial". The forced flag governs how we
# present ourselves: absence from the Peer Crawler (/crawl) response, and the
# handshake Crawl header — OBSERVED at 3.2.1, src/xrpld/overlay/detail/PeerImp.cpp
# passes `!config().peerPrivate` into makeResponse(). What it does NOT govern is
# our address reaching others. Endpoint GOSSIP is gated on wantIncoming, which 0 turns
# ON: PeerFinder Logic.h inserts an entry for ourselves at hops=0 into the endpoint
# handout to every target when `config_.wantIncoming && counts_.inMax() > 0`;
# recipients substitute our real socket address and relay it onward via the
# Livecache. So our address propagates to nodes we never connected to — not merely
# to peers we dialled. We remain absent from Peer Crawler results, which is a
# narrower guarantee than "the address stays private".
#
# This is a deliberate availability-over-concealment call by the final architect,
# made with the exposure above understood. Revisit if the CS-operated proxy tier
# lands: that is the durable fix and delivers peer diversity with NO endpoint gossip
# from the validator itself.
#
[peer_private]
0

# EXPLICIT slot posture — the inbound surface opened above is bounded here on
# purpose rather than left to rippled's derived defaults, because "whatever the
# default computes" is not a decision an operator can audit.
#
# Verified on the DEPLOYED tag, XRPLF/rippled 3.2.1:
#   src/xrpld/core/detail/Config.cpp
#     - [peers_out_max] must be in range 10-1000, else rippled THROWS at load
#     - [peers_in_max] must be <= 1000
#     - BOTH sections must be set or NEITHER — configuring one alone throws
#       "Both sections [peers_in_max] and [peers_out_max] must be configured".
#       That is a boot failure on a production validator; never add one alone.
#     - [peers_max], if set, takes precedence and these two are ignored entirely.
#   src/xrpld/peerfinder/detail/PeerfinderConfig.cpp
#     - setting both takes the explicit branch: outPeers/inPeers come straight
#       from these values and maxPeers is no longer derived.
#
# 20 outbound gives discovery room to actually find peers beyond the [ips_fixed]
# floor — that discovery is the whole reason for peer_private=0. 10 inbound caps
# the stranger-session surface that comes with it.
#
# CAPACITY — read this before assuming the node got a little bigger. Total
# non-fixed slots become 20 + 10 = 30, against a derived default of ~21 before this
# change, and the [ips_fixed] peers stack ON TOP because they bypass slot
# accounting. Budget file descriptors, CPU and egress for that, not for 21.
#
# SURPRISE — in the explicit branch PeerfinderConfig.cpp sets maxPeers = 0 (it is
# only derived in the auto branch). OverlayImpl::limit() returns
# peerFinder_->config().maxPeers, so `max_peers` in the overlay property stream and
# anything reading limit() will report 0. That is an artefact of configuring the
# two sections explicitly — it does NOT mean no peers are allowed. Do not wire an
# alert to that field.
#
# CONSEQUENCE, do not "optimise" this to 0: inbound slots are also what arms the
# hops=0 self-advertisement (Logic.h requires counts_.inMax() > 0). Setting
# [peers_in_max] 0 would silence our endpoint gossip entirely — which is a
# legitimate posture, but a DIFFERENT one than was chosen here, and it forfeits
# the network reachability this change is meant to buy.
[peers_out_max]
20

[peers_in_max]
10

# Curated mainnet hub peers for outbound bootstrap reliability.
# [ips_fixed] peers bypass slot accounting and stay connected regardless of slot
# pressure, so these stay the RELIABLE floor even now that discovery is on — they
# are no longer the entire outbound set. Inbound slots are set explicitly above;
# see that stanza before changing them.
#
# Hubs VERIFIED 2026-06-17 against:
#   https://xrpl.org/docs/infrastructure/configuration/server-modes/run-xrpld-as-a-validator
#   (xrpl.org lists r.ripple.com, sahyadri.isrdc.in, hubs.xrpkuwait.com,
#   hub.xrpl-commons.org as recommended public hubs; doc warns list may
#   evolve — re-verify at upgrade time against xrpld-example.cfg in
#   https://github.com/XRPLF/rippled/blob/master/cfg/xrpld-example.cfg)
# CONSVAL1 peer-redundancy: ALL FOUR vetted hubs pinned. With only the first two,
# the proposing validator held a single live peer (35.158.172.184) — a single
# point of failure for both sync and validation relay. Four fixed hubs across
# distinct operators/regions removes that; [ips_fixed] peers ignore slot pressure.
#
# 2026-06-21 from-the-box diagnosis (egress is NOT the issue — :51235 outbound is
# permitted by the deny-floor and works): live peers were only 2 of 4 —
#   r.ripple.com        TCP-OK, peered
#   hubs.xrpkuwait.com  TCP-OK, peered
#   hub.xrpl-commons.org TCP-OK but no XRPL session (busy/flaky non-Ripple hub)
#   sahyadri.isrdc.in   Connection REFUSED (hub down on :51235; reached, refused)
# Added zaphod.alloy.ee (Alloy Networks, EU — long-standing HA bootstrap hub;
# TCP-OK from this box, the one extra hub with a citable source) for a 3rd
# reliably-connected distinct operator. Under the prior peer_private=1 this list WAS
# the entire outbound set; with discovery on it is the guaranteed floor beneath it.
# Keep every reputable hub pinned — discovery supplements, it does not replace.
#
# 2026-07-23: + hub.distributedagreement.com; - sahyadri (TCP refused). Dead
# [ips_fixed] entries are NOT free (retry churn + false capacity picture).
#
# 2026-07-31 multi-path pin (PR #26 dual-gate): hostname-only yields ONE fixed
# peer per multi-A name (PeerFinder addFixedPeer). IAP `peers` inventory after
# the #23 recreate (2026-07-31 ~22:05 UTC):
#   18.209.223.102  n9LQMf…  domain=ripple.com           uptime~1600s  STABLE
#   205.209.113.250 n9Juuy…  domain=distributedagreement  uptime~1550s  STABLE
#   zaphod/kuwait: open → "No message of desired type" → close (FLAP — do not
#   multi-pin those operators until post-handshake refusal is understood).
# Shape: ALL five hostnames (DNS self-heal for the fixed floor) PLUS extra
# concurrent A-records for the Ripple pool + measured-stable DA IP. Hostnames
# + overlapping IPs dedupe by endpoint (emplace fails → next A); they do NOT
# double-attempt the same key. Flappers stay hostname-only. ≥8 still needs a
# CS-operated peer node.
[ips_fixed]
# Operator hostnames (DNS self-heal)
r.ripple.com 51235
hub.distributedagreement.com 51235
hubs.xrpkuwait.com 51235
zaphod.alloy.ee 51235
hub.xrpl-commons.org 51235
# Extra concurrent endpoints (measured-stable + additional Ripple pool A-records;
# TCP:51235 OK 2026-07-31). Distinct pubkey_node not proven for every Ripple A —
# DuplicatePeer rejects same key. DA IP is the measured-stable session.
18.209.223.102 51235
35.158.172.184 51235
44.205.42.42 51235
52.40.102.255 51235
35.167.183.116 51235
205.209.113.250 51235

# Mainnet network identifier (prevents cross-network peer confusion).
[network_id]
main

# UNL statically pinned — runtime fetch via [validator_list_sites] is
# intentionally absent (egress deny-floor blocks HTTPS to UNL endpoints).
# Both canonical publisher keys are listed for redundancy; see validators.txt
# for the full rationale and verification record.
#
# Keys VERIFIED 2026-06-17 against:
#   https://github.com/XRPLF/rippled/blob/master/cfg/validators-example.txt
[validator_list_keys]
ED2677ABFFD1B33AC6FBC3062B71F1E8397C1505E1C42C64D11AD1B28FF73F4734
ED42AEC58B701EEBB77356FFFEC26F83C1F0407263530F068C7C73D392C7E06FD1

# Threshold auto-computed from key count (0 = auto).
[validator_list_threshold]
0

# Route xrpld's log output to the container's stdout so the gcplogs driver ships it
# to Cloud Logging. WITHOUT this, gcplogs (enable_gcplogs=true) captures only the
# pre-init startup banner — xrpld's ongoing journal never surfaces past the docker
# stdout pipe even at log_level info (proposing+healthy yet silent; confirmed on this
# validator 2026-06-19). The file sink flushes deterministically. Fix proven on
# svc-rippled-dev (200 ongoing log lines/5min) before this roll-out.
[debug_logfile]
/dev/stdout

# info-level logging for mainnet operational visibility. The testnet tracking
# node used `warning` which hid the consensus narrative (dev readiness gap #11).
# A validator needs `info` to surface proposal/validation events in Cloud Logging.
[rpc_startup]
${"{"}  "command": "log_level", "severity": "info" ${"}"}

[ssl_verify]
1
